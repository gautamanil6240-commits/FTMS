# FTMS environment variables — copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored; this example file is safe to commit.

# Django → python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-key

# MySQL database (project default: ftms_db on localhost:3306)
DB_NAME=ftms_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# SMTP for password-reset emails (Gmail App Password, not your login password)
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
